# syntax=docker/dockerfile:1
# Build from repo root (compose: context: ..)
#   docker build -f docker/Dockerfile.backend \
#     --build-arg BACKEND_DIR=ayanlab-auth/ayanlab-auth-backend \
#     -t ayanlab-auth-backend .

ARG BACKEND_DIR
FROM eclipse-temurin:21-jdk-alpine AS build
ARG BACKEND_DIR
WORKDIR /build
RUN apk add --no-cache bash
COPY libs libs/
COPY ${BACKEND_DIR}/gradle ${BACKEND_DIR}/gradle
COPY ${BACKEND_DIR}/gradlew ${BACKEND_DIR}/gradlew
COPY ${BACKEND_DIR}/build.gradle.kts ${BACKEND_DIR}/settings.gradle.kts ${BACKEND_DIR}/
COPY ${BACKEND_DIR}/src ${BACKEND_DIR}/src
WORKDIR /build/${BACKEND_DIR}
RUN chmod +x gradlew && ./gradlew bootJar -x test --no-daemon

FROM eclipse-temurin:21-jre-alpine
ARG BACKEND_DIR
WORKDIR /app
COPY --from=build /build/${BACKEND_DIR}/build/libs/*.jar app.jar
ENV SERVER_PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]