# syntax=docker/dockerfile:1
# UI + Spring Boot in one image (optional). Example build:
#   docker build -f docker/Dockerfile.fullstack \
#     --build-arg BACKEND_DIR=ayanlab-auth/ayanlab-auth-backend \
#     --build-arg UI_DIR=ayanlab-auth/ayanlab-auth-ui \
#     -t ayanlab-auth-fullstack .

ARG UI_DIR
ARG BACKEND_DIR

FROM node:22-alpine AS ui-build
ARG UI_DIR
WORKDIR /ui
COPY ${UI_DIR}/package.json ./
RUN npm install
COPY ${UI_DIR}/ ./
RUN npm run build

FROM maven:3.9.9-eclipse-temurin-21-alpine AS api-build
ARG BACKEND_DIR
WORKDIR /workspace
COPY ayanlab-platform/pom.xml ayanlab-platform/pom.xml
COPY ayanlab-platform/ayanlab-platform-core ayanlab-platform/ayanlab-platform-core
RUN mvn -f ayanlab-platform/pom.xml install -pl ayanlab-platform-core -am -DskipTests -q
COPY ${BACKEND_DIR}/pom.xml ${BACKEND_DIR}/pom.xml
RUN mvn -f ${BACKEND_DIR}/pom.xml dependency:go-offline -B -q || true
COPY ${BACKEND_DIR}/src ${BACKEND_DIR}/src
RUN mvn -f ${BACKEND_DIR}/pom.xml package -DskipTests -q

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache nginx
WORKDIR /app
COPY --from=api-build /workspace/${BACKEND_DIR}/target/*.jar /app/app.jar
COPY --from=ui-build /ui/dist /usr/share/nginx/html
COPY docker/nginx-fullstack.conf /etc/nginx/http.d/default.conf
COPY docker/entrypoint-fullstack.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]