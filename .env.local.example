# cp .env.local.example .env.local  — secrets stay local (gitignored)
# Validate: ./scripts/validate-env-local.sh

AYANLAB_ENV=local
TZ=America/Los_Angeles

# Postgres bootstrap (docker superuser — creates per-service DBs on first init)
POSTGRES_SUPERUSER=ayanlab_super
POSTGRES_SUPERUSER_PASSWORD=change-me-super
# Legacy aliases used by some compose keys
POSTGRES_USER=ayanlab_super
POSTGRES_PASSWORD=change-me-super
POSTGRES_DB=postgres

# --- platform (auth + business APIs, single JVM) ---
PLATFORM_DB_NAME=ayanlab_platform
PLATFORM_DB_USER=platform_admin
PLATFORM_DB_PASSWORD=change-me-platform
PLATFORM_DB_SCHEMA=core

# --- booking ---
BOOKING_DB_NAME=ayanlab_booking
BOOKING_DB_USER=booking_admin
BOOKING_DB_PASSWORD=change-me-booking
BOOKING_DB_SCHEMA=booking

# --- crm ---
CRM_DB_NAME=ayanlab_crm
CRM_DB_USER=crm_admin
CRM_DB_PASSWORD=change-me-crm
CRM_DB_SCHEMA=crm

# --- hrm ---
HRM_DB_NAME=ayanlab_hrm
HRM_DB_USER=hrm_admin
HRM_DB_PASSWORD=change-me-hrm
HRM_DB_SCHEMA=staffiq

# --- pms (property) ---
PMS_DB_NAME=ayanlab_pms
PMS_DB_USER=pms_admin
PMS_DB_PASSWORD=change-me-pms
PMS_DB_SCHEMA=ipms

# --- vault ---
VAULT_DB_NAME=ayanlab_vault
VAULT_DB_USER=vault_admin
VAULT_DB_PASSWORD=change-me-vault
VAULT_DB_SCHEMA=vault

# --- communication ---
COMM_DB_NAME=ayanlab_comm
COMM_DB_USER=comm_admin
COMM_DB_PASSWORD=change-me-comm
COMM_DB_SCHEMA=comm

# Host ports published by docker-compose.platform.yml (5433/6380 avoids poc-* on 5432/6379)
AYANLAB_POSTGRES_HOST_PORT=5433
AYANLAB_REDIS_HOST_PORT=6380

# Spring local bootRun (ayanlab-platform/run-local.sh maps PLATFORM_* → POSTGIS_*)
POSTGIS_HOST=localhost
POSTGIS_PORT=5433

# Any length works locally (short values are SHA-256–derived); prod: use openssl rand -base64 32
JWT_SECRET=change-me-local-dev-only-not-for-prod

KAFKA_SERVERS=localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATA_REDIS_HOST=localhost

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

GCP_PROJECT_ID=
GCP_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_CREDENTIALS_RESOURCE=

VPS_USER=root
VPS_HOST=
REMOTE_DIR=/root/dockers/ayanlab
PRODUCT=all
SSH_KEY=

AYANLAB_PLATFORM_URL=http://localhost:8102