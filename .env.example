# Copy to repo root: cp .env.example .env
# Real secrets live only in .env (gitignored). Never commit .env.

# --- PostgreSQL (docker: host=postgres, local: localhost) ---
POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=ayanLabs
POSTGIS_USER=ayanlab
POSTGRES_USER=ayanlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ayanLabs
POSTGIS_PASSWORD=change-me
POSTGIS_SCHEMA=core
POSTGIS_SCHEMAS=core,ipms,crm,vault,staffiq
# POSTGIS_URL=jdbc:postgresql://localhost:5432/ayanLabs?currentSchema=core

TZ=UTC

# --- JWT (quote if special chars) ---
JWT_SECRET=change-me

# --- Kafka / Redis (infra compose service names in Docker) ---
KAFKA_SERVERS=localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_DATA_REDIS_HOST=redis

# --- Mail ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- GCP (JSON file OUTSIDE repo or in config/secrets/) ---
GCP_PROJECT_ID=
GCP_BUCKET_NAME=
# Path to service account JSON on your machine (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=
# Optional Spring resource, e.g. file:/path/to/key.json
GCP_CREDENTIALS_RESOURCE=

# --- VPS deploy (scripts/publish-vps.sh) ---
VPS_USER=root
VPS_HOST=
REMOTE_DIR=/root/dockers/ayanlab
PRODUCT=all
SSH_KEY=