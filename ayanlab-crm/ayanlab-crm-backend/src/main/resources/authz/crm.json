  "policyGroups": [
    {
      "code": "CRM_ROLE_ADMIN",
      "name": "Administrator Permissions",
      "description": "CRM full access for role ADMIN",
      "permissions": [
        "crm:*:*"
      ]
    },
    {
      "code": "CRM_ACCOUNTING_READ",
      "name": "CRM Accounting Read",
      "permissions": [
        "crm:accounting:read",
        "crm:invoices:read",
        "crm:clients:read"
      ]
    },
    {
      "code": "CRM_ROLE_ORGANIZATION_ADMINISTRATOR",
      "name": "Organization Administrator Permissions",
      "description": "CRM permission matrix for role ORGANIZATION_ADMINISTRATOR",
      "permissions": [
        "crm:*:*"
      ]
    },
    {
      "code": "CRM_ROLE_SYSTEM_ADMINISTRATOR",
      "name": "System Administrator Permissions",
      "description": "CRM permission matrix for role SYSTEM_ADMINISTRATOR",
      "permissions": [
        "crm:*:*"
      ]
    },
    {
      "code": "CRM_ROLE_VENDOR",
      "name": "Vendor (Personal) Permissions",
      "description": "CRM permission matrix for role VENDOR",
      "permissions": [
        "crm:dashboard:read",
        "crm:clients:read",
        "crm:contacts:read",
        "crm:invoices:read",
        "crm:files:read"
      ]
    },
    {
      "code": "CRM_ROLE_VIEWER",
      "name": "Viewer (Read Only) Permissions",
      "description": "CRM permission matrix for role VIEWER",
      "permissions": [
        "crm:dashboard:read",
        "crm:clients:read",
        "crm:contacts:read",
        "crm:reports:read",
        "crm:settings:read"
      ]
    }
  ],
  "roles": [
    {
      "code": "ADMIN",
      "name": "Administrator",
      "description": "Full access",
      "policyGroups": [
        "CRM_ROLE_ADMIN",
        "CRM_ACCOUNTING_READ"
      ]
    },
    {
      "code": "ORGANIZATION_ADMINISTRATOR",
      "name": "Organization Administrator",
      "description": "Full access to organization data, users, and settings",
      "policyGroups": [
        "CRM_ROLE_ORGANIZATION_ADMINISTRATOR"
      ]
    },
    {
      "code": "SYSTEM_ADMINISTRATOR",
      "name": "System Administrator",
      "description": "Full system access with ability to manage all organizations and system settings",
      "policyGroups": [
        "CRM_ROLE_SYSTEM_ADMINISTRATOR"
      ]
    },
    {
      "code": "VENDOR",
      "name": "Vendor (Personal)",
      "description": "Personal vendor account without company affiliation",
      "policyGroups": [
        "CRM_ROLE_VENDOR"
      ]
    },
    {
      "code": "VIEWER",
      "name": "Viewer (Read Only)",
      "description": "Read-only access to permitted modules (legacy alias toward SYSTEM_USER)",
      "policyGroups": [
        "CRM_ROLE_VIEWER"
      ]
    }
  ]
